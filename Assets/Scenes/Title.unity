  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'A match has 3 rounds. In each round, you and the CPU take turns drawing from one shared deck, which is freshly shuffled every round. Who goes first is decided at random each round.

    On your turn, either draw a card or stop. Using fortune tools does not end your turn.

    Once one of you stops or breaks, the other keeps drawing alone until they stop too.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dfdfbb81a1e632e4e943931cba6a0c09, type: 2}
