  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Only the one who folds <b>last</b> can get the Foresight Bonus. If you fold first, your score is fixed right away and no card is turned over.

    Wait until the CPU has folded or broken, then fold: the next card is turned over, and if it is unlucky, your score is multiplied by 1.5.

    If the deck runs out, anyone still reading is scored without the bonus.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dfdfbb81a1e632e4e943931cba6a0c09, type: 2}
  m_sharedMaterial: {fileID: -2096482529580773300, guid: dfdfbb81a1e632e4e943931cba6a0c09, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
