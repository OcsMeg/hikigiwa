  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'You and the CPU each start with 3 Spirit and gain 1 after every round that is not ruined. Spirit carries over between rounds. The CPU never uses fortune tools.

    There are no Quotas. After 3 rounds, the higher total score wins. Equal scores are a draw.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dfdfbb81a1e632e4e943931cba6a0c09, type: 2}
