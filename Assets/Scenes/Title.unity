      m_Calls: []
  m_text: 'Each customer has a secret <color=#ECC470>Lucky Number</color> and a secret <color=#EC6262>Unlucky Number</color>. You will not know them until you draw them.

    - <color=#ECC470>Lucky Number</color>: 2 cards in the deck.

    - <color=#EC6262>Unlucky Number</color>: 2 cards in the deck. The Joker is always unlucky too, so there are 3 unlucky cards in all.

    The screen shows how many lucky and unlucky cards are still left in the deck.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dfdfbb81a1e632e4e943931cba6a0c09, type: 2}
