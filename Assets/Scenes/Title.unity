  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Each card you draw adds its number to the customer''s <b>Luck</b>.

    - <color=#ECC470>Lucky card</color>: your <b>Multiplier</b> goes up by 1. It starts at 1.

    - <color=#EC6262>Ill card</color>: you receive an <b>Ill Omen</b> mark. Its number still adds to Luck (the Joker adds 0).

    Collect 2 Ill Omen marks and the reading breaks: <color=#EC6262>this customer gives you 0 points</color>.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dfdfbb81a1e632e4e943931cba6a0c09, type: 2}
